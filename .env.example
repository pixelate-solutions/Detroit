# AI provider: auto (Ollama if reachable with both models, else the CPU-only demo provider), ollama, or demo.
CIVIC_RECORDS_AI=auto
# Demo mode enables one-click sign-in as the seeded fictional accounts. Never enable in production.
CIVIC_RECORDS_DEMO=0
CIVIC_RECORDS_DEPLOYMENT=Rivergate Fire Department (fictional demo)
# CIVIC_RECORDS_DATA_DIR=/absolute/path/to/local-data

# Local model configuration. Non-loopback OLLAMA_BASE_URL values are rejected at startup.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_LLM_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
